# Django — Environment Variables
# Copy this file to .env in backend/ and fill in the values.

# ── Django Core Settings ──
# Generate a key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS — comma-separated origins allowed to make API requests
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database: 'mysql' or 'sqlite3' ──
DB_ENGINE=mysql
DB_NAME=portfolio_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=localhost
DB_PORT=3306

# ── Email Notification Configuration (SMTP) ──
# To receive real-time email notifications to prawar65@gmail.com:
#
# Option A: Gmail SMTP (Recommended)
# 1. Enable 2-Step Verification on your Google Account (myaccount.google.com/security)
# 2. Go to "App passwords" (myaccount.google.com/apppasswords)
# 3. Create a new App Password named "Portfolio Website"
# 4. Copy the generated 16-character password into EMAIL_HOST_PASSWORD below.
#
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=prawar65@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_google_app_password
DEFAULT_FROM_EMAIL=prawar65@gmail.com
PORTFOLIO_OWNER_EMAIL=prawar65@gmail.com

# ── External Integrations ──
GITHUB_USERNAME=prawar-hash
